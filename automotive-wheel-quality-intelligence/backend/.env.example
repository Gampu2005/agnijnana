# =============================================================================
# Automotive Wheel Quality Intelligence — Backend Environment Variables
# =============================================================================

# Server Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# Application Secret Key
SECRET_KEY=change_this_to_a_secure_random_64_character_string_in_production

# Backend Base URL
API_BASE_URL=http://localhost:8000

# PostgreSQL Database Connection String (Optional for standalone CV inspection)
DATABASE_URL=postgresql://quality_user:quality_secret@localhost:5432/quality_db

# Allowed CORS Origins (comma-separated, or '*' for unrestricted cloud testing)
CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188,http://localhost:5173,http://localhost:3000

# (Optional) Supabase Storage & Remote Sync
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=wheel-images
