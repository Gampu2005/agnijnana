# =============================================================================
# Agnijnana — Automotive Component Quality Inspection System
# Environment Configuration Template
# =============================================================================

# Application Environment ('development', 'staging', 'production')
ENVIRONMENT=development

# Application Secret Key (Set a random 64-char key in production)
SECRET_KEY=dev_secret_key_insecure_default_singularity_2026

# Backend REST API Base URL
API_BASE_URL=http://localhost:8000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://quality_user:quality_secret@localhost:5432/quality_db

# (Optional) Supabase Object Storage & REST Sync
# Leave blank to use local file system storage in backend/app/data/uploads/
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=quality-inspection-images

# Local AI Model Weights Directory
MODEL_PATH=ai/model_assets/

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (Used by Vite)
VITE_API_BASE_URL=http://localhost:8000
